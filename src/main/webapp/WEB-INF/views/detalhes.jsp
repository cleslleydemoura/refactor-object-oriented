<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="tags.jspf" %>
<c:set var="tituloPagina" value="${item.titulo}"/>
<%@ include file="cabecalho.jspf" %>
<a class="back-link" href="${pageContext.request.contextPath}/itens">← Voltar ao catálogo</a>
<article class="detail-layout"><div class="detail-art card-art art-${item.tipoMidia}"><span class="art-label"><c:out value="${item.tipoMidia.descricao}"/></span><span class="art-letter" aria-hidden="true"><c:out value="${fn:substring(item.titulo, 0, 1)}"/></span><span class="art-year">${item.anoLancamento}</span></div><div class="detail-content"><p class="eyebrow"><c:out value="${item.genero}"/></p><h1><c:out value="${item.titulo}"/></h1><p class="detail-author"><c:out value="${item.autorDiretor}"/></p><dl class="metadata"><div><dt>Tipo</dt><dd><c:out value="${item.tipoMidia.descricao}"/></dd></div><div><dt>Ano</dt><dd>${item.anoLancamento}</dd></div><div><dt>Identificador</dt><dd>#${item.id}</dd></div></dl><h2>Sobre a obra</h2><p class="full-synopsis"><c:out value="${item.sinopse}"/></p><div class="detail-actions"><a class="button" href="${pageContext.request.contextPath}/itens/editar?id=${item.id}">Editar informações</a><button type="button" class="button button-danger" data-open-delete>Excluir item</button></div>
<details class="delete-panel" id="confirmar-exclusao"><summary>Confirmar exclusão</summary><p>Excluir “<c:out value="${item.titulo}"/>” do catálogo? Esta ação não pode ser desfeita.</p><form action="${pageContext.request.contextPath}/itens/excluir" method="post"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="id" value="${item.id}"><button type="submit" class="button button-danger">Sim, excluir este item</button></form></details></div></article>
<%@ include file="rodape.jspf" %>
